---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Remark42 from "../components/Remark42.astro";

const modules = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/img/you/*.jpg",
    { eager: true },
);
const photos = Object.entries(modules)
    .sort((a, b) => a[0].localeCompare(b[0], undefined, { numeric: true }))
    .map(([, mod]) => mod.default);
---

<Layout
    title="Sizden Gelenler | Yeşil Mavi Hayat"
    description="Okurların Yeşil Mavi Hayat ile paylaştığı kareler ve düşünceler."
>
    <main>
        <section class="pagehero">
            <div class="wrap">
                <header class="page-head">
                    <p class="kicker kicker--center reveal">Sizden Gelenler</p>
                    <h1 class="display page-head__title reveal">
                        Okurların kareleri
                    </h1>
                    <p class="page-head__intro reveal">
                        Kitabevlerinden, evlerden, yolculuklardan… Yeşil Mavi
                        Hayat’ı okurların objektifinden görmek en güzeli.
                    </p>
                </header>
            </div>
        </section>

        <section class="section paper">
            <div class="wrap">
                <div
                    class="ygallery"
                    role="group"
                    aria-label="Okur fotoğrafları"
                >
                    {
                        photos.map((photo) => (
                            <figure class="ygallery__item reveal">
                                <Image
                                    src={photo}
                                    alt="Bir okurun Yeşil Mavi Hayat karesi"
                                    width={420}
                                    loading="lazy"
                                />
                            </figure>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="section--tight comments">
            <div class="wrap wrap--narrow">
                <h2 class="display h2 reveal">Siz ne düşünüyorsunuz?</h2>
                <div class="reveal"><Remark42 /></div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .ygallery {
        columns: 220px;
        column-gap: 1rem;
    }
    .ygallery__item {
        break-inside: avoid;
        margin: 0 0 1rem;
        border-radius: 14px;
        overflow: hidden;
        background: var(--aqua-2);
        box-shadow: 0 14px 34px -20px rgba(16, 52, 58, 0.5);
    }
    .ygallery__item :global(img) {
        display: block;
        width: 100%;
        height: auto;
        transition: transform 0.4s ease;
    }
    .ygallery__item:hover :global(img) {
        transform: scale(1.04);
    }
    .comments {
        padding-inline: 1.5rem;
        text-align: center;
    }
    .comments :global(#remark42) {
        margin-top: 2rem;
        text-align: left;
    }
</style>
