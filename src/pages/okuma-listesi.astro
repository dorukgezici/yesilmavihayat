---
import Layout from "../layouts/Layout.astro";

// Esin ve bilgi kaynakları — "Author / Title" per line.
const raw = [
    "Ahmet Soysal / Bir Ekolojistin Not Defteri",
    "Alain de Botton / Felsefenin Tesellisi",
    "Alan Watts / Mutluluğun Anlamı",
    "Ali Ayten / Tasavvuf Psikolojisi",
    "Antonio Damasio / Descartes’ın Yanılgısı",
    "Aristoteles / Nikomakhos’a Etik",
    "Arthur Schopenhauer / İnsan Doğası Üzerine",
    "Arthur Schopenhauer / Yaşam Bilgeliği Üzerine Aforizmalar",
    "Aslı Perker / Hoş Geldin Yabancı, Burada En Büyük Amacımız Mutluluktur-Epikür",
    "Aslı Perker / Kendisinin Efendisi Olmayan Hiç Kimse Özgür Değildir-Epiktetos",
    "Bill Gates / İklim Felaketini Nasıl Önleriz",
    "Carl Sagan / Kozmos",
    "Carl Sagan / Soluk Mavi Nokta",
    "Cemalnur Sargut / Allah’ıma Sefere Çıktım",
    "Charles Darwin / İnsan ve Hayvanlarda Duyguların İfade Edilmesi",
    "Charles Darwin / İnsanın Türeyişi",
    "Charles Darwin / Türlerin Kökeni",
    "Christopher Peterson-Martin Seligman / Character Strengths and Virtues: A Handbook and Classification",
    "Cicero / Dostluk Üzerine-De Amicitia",
    "Cicero / Yaşlı Cato ve Yaşlılık Üzerine",
    "Damon Young / Bahçede Felsefe",
    "Dan Buettner / Mavi Bölgeler",
    "Daniel Chamovitz / Bitkilerin Bildikleri",
    "Doğan Cüceloğlu / Var mısın? Güçlü Bir Yaşam İçin Öneriler",
    "Dr. Murat Kınıkoğlu / Vegan Beslenme",
    "Edward Osborne Wilson / Biophilia",
    "Edward Osborne Wilson / Doğanın Gizli Bahçesi",
    "Emanuele Coccia / Bitkilerin Yaşamı-Bir Karışım Metafiziği",
    "Engin Geçtan / Hayat",
    "Engin Geçtan / İnsan Olmak",
    "Engin Geçtan / Rastgele Ben",
    "Epiktetos / İçsel Huzur İyi Yaşamın Kapısını Açar",
    "Erich Fromm / İnsandaki Yıkıcılığın Kökenleri",
    "Farabi / Mutluluğun Kazanılması",
    "Ferhat Jak İçöz / Kendin Olmanın Dayanılmaz Hafifliği",
    "Feza Karakaş / Mutluluk Projesi",
    "Francis Bacon / Denemeler",
    "Franz Kafka / Dava",
    "Frederic Gros / Yürümenin Felsefesi",
    "Friedrich Nietzsche / Böyle Buyurdu Zerdüşt",
    "George Monbiot / Yaban Yaşam",
    "Gülin Yücel-Levent Kurnaz / Yeni Gerçeğimiz Sürdürülebilirlik",
    "Gündüz Vassaf / Cehenneme Övgü",
    "Halil Cibran / Ermiş",
    "Hector Garcia-Francesc Miralles / Ikigai",
    "Henry David Thoreau / Nerede ve Ne İçin Yaşadım",
    "Henry David Thoreau / Walden-Ormanda Yaşam",
    "Henry David Thoreau / Yürümek",
    "Hermann Hesse / Ağaçlar",
    "Hermann Hesse / Öldürmeyeceksin",
    "H. G. Wells / Zaman Makinesi",
    "İhsan Fazlıoğlu / Kendini Aramak",
    "İlber Ortaylı / Bir Ömür Nasıl Yaşanır",
    "İlber Ortaylı / İnsan Geleceğini Nasıl Kurar",
    "James Joyce / Ulysses",
    "Jason Hickel / Çoğu Zarar Azı Karar-Dünyayı Küçülme Kurtaracak",
    "Jean-Jacques Rousseau / Eşitsizliğin Kökeni",
    "Jean-Jacques Rousseau / Yalnız Gezer’in Düşleri",
    "Jonathan Balcombe / Balıkların Bildikleri",
    "Jonathan Safran Foer / Hayvan Yemek",
    "John Fowles / Ağaçlar",
    "Kiraz Özdoğan, M. Fatih Tatari, Ali Bilgin / İnsan Hayvan ve Ötesi",
    "Kolektif-Editör Samet Kılıç / Halkbilimi Bağlamında Türkiye’de Yeme-İçme Kültürü",
    "Laozi / Yol ve Erdem",
    "Marc Bekoff / Hayvanların Duygusal Dünyası",
    "Marcus Aurelius / Kendime Düşünceler",
    "Matt Haig / İnsanlar",
    "Matthieu Ricard / Mutluluğa Övgü",
    "Maureen Gaffney / Your One Wild and Precious Life",
    "Mesud Topal / Var mısın ki Yok Olmaktan KorkuyorsunFarabi",
    "Metehan Tanyıldız / İlim Anavatanımızdır, Cehalet ise Yabancı Bir Yer-İbni Rüşd",
    "Michel Serres / Doğayla Sözleşme",
    "Mihaly Csikszentmihalyi / Akış-Mutluluk Bilimi",
    "Montaigne / Denemeler",
    "Nermi Uygur / Yaşama Felsefesi",
    "Norman Hampson / Aydınlanma Çağı",
    "Öykü Yaman, Emine Aksoydan / Sürdürülebilir Yaşam Rehberi",
    "Özlem Küskü / Dışa Bakan Rüya Görür İçe Bakan Uyanır-Carl Gustav Jung",
    "Peter Singer / Hayvan Özgürleşmesi",
    "Peter Singer / Neden Vegan",
    "Peter Wohlleben / Ağaçların Gizli Yaşamı",
    "Peter Wohlleben / Hayvanların Gizli Yaşamı",
    "Platon / Diyaloglar",
    "Ralph Waldo Emerson / Doğa",
    "Ralph Waldo Emerson / Nefse İtimat",
    "Richard Louv / Doğadaki Son Çocuk",
    "Sait Faik Abasıyanık / Son Kuşlar",
    "Samuel Beckett / Aşksız İlişkiler",
    "Seneca / Yaşamın Kısalığı Üzerine",
    "Sinan Canan / İFA-İnsanın Fabrika Ayarları-1. Kitap",
    "Stefan Zweig / Montaigne: Her Şeyin Birazı, Hiçbir Şeyin Hepsi",
    "Stefano Mancuso / Bitki Ulusu",
    "Stuart Walton / A Natural History of Human Emotions",
    "Viktor Emil Frankl / İnsanın Anlam Arayışı",
    "Walther Kranz / Antik Felsefe",
    "Wilhelm Schmid / Dokunmak Üstüne",
    "Wilhelm Schmid / Kendiyle Dost Olmak",
    "Wilhelm Schmid / Mutsuz Olmak: Bir Yüreklendirme",
    "Wilhelm Schmid / Sakin Olmak",
    "Yaşar Kemal / İnce Memed 3",
    "Yuval Noah Harari / Hayvanlardan Tanrılara-Sapiens",
    "Zülal Kalkandelen / Vegan Devrimi ve Hayvan Özgürlüğü",
    "Zygmunt Bauman / Yaşam Sanatı",
];

const entries = raw.map((line) => {
    const i = line.indexOf(" / ");
    return i === -1
        ? { author: line, work: "" }
        : { author: line.slice(0, i), work: line.slice(i + 3) };
});

// Already alphabetical by author — group by first letter (Turkish casing).
const groups: { letter: string; items: typeof entries }[] = [];
for (const e of entries) {
    const letter = e.author.charAt(0).toLocaleUpperCase("tr");
    let group = groups.find((g) => g.letter === letter);
    if (!group) {
        group = { letter, items: [] };
        groups.push(group);
    }
    group.items.push(e);
}
---

<Layout
    title="Okuma Listesi | Yeşil Mavi Hayat"
    description="Yeşil Mavi Hayat’a ilham veren esin ve bilgi kaynakları: felsefeden doğaya, psikolojiden edebiyata bir okuma listesi."
>
    <main>
        <section class="pagehero">
            <div class="wrap">
                <header class="page-head">
                    <p class="kicker kicker--center reveal">Okuma Listesi</p>
                    <h1 class="display page-head__title reveal">
                        Esin ve Bilgi Kaynakları
                    </h1>
                    <p class="page-head__intro reveal">
                        Yeşil Mavi Hayat’ı besleyen {entries.length} kitap; felsefeden
                        doğaya, psikolojiden edebiyata uzanan bir okuma yolculuğu.
                    </p>
                </header>
            </div>
        </section>

        <section class="section paper">
            <div class="wrap">
                <div class="biblio">
                    {
                        groups.map((group) => (
                            <section class="biblio__group reveal">
                                <h2 class="biblio__letter display">
                                    {group.letter}
                                </h2>
                                <ul class="biblio__list">
                                    {group.items.map((it) => (
                                        <li>
                                            <span class="biblio__author">
                                                {it.author}
                                            </span>
                                            {it.work && (
                                                <span class="biblio__work">
                                                    {it.work}
                                                </span>
                                            )}
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .biblio {
        columns: 300px;
        column-gap: 2.75rem;
    }
    .biblio__group {
        break-inside: avoid;
        margin-bottom: 2.5rem;
    }
    .biblio__letter {
        font-size: 2.4rem;
        line-height: 1;
        color: var(--teal);
        margin: 0 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--line);
    }
    .biblio__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }
    .biblio__author {
        display: block;
        font-weight: 600;
        font-size: 0.95rem;
        line-height: 1.35;
        color: var(--ink);
    }
    .biblio__work {
        display: block;
        font-size: 0.9rem;
        line-height: 1.4;
        color: var(--ink-soft);
    }
</style>
