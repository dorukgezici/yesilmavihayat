---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const stories = await getCollection("stories");
    return stories.map((story) => ({
        params: { slug: story.id },
        props: { story },
    }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const formatted = new Date(story.data.date).toLocaleDateString("tr", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
const description =
    story.data.excerpt.length > 155
        ? story.data.excerpt.slice(0, 152).trimEnd() + "…"
        : story.data.excerpt;
---

<Layout
    title={`${story.data.title} | Yeşil Mavi Hayat`}
    description={description}
>
    <main>
        <section class="pagehero">
            <div class="wrap wrap--narrow story-head">
                <a href="/oykuler" class="back link-underline">← Öyküler</a>
                <p class="kicker kicker--center">Öykü</p>
                <h1 class="display story-title">{story.data.title}</h1>
                <p class="story-date">{formatted}</p>
            </div>
        </section>

        <section class="section paper">
            <article class="reading">
                <Content />
            </article>
        </section>
    </main>
</Layout>

<style>
    .story-head {
        text-align: center;
    }
    .back {
        display: inline-block;
        font-family: var(--font-gotu);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 1.75rem;
    }
    .story-title {
        font-size: clamp(2.6rem, 7vw, 4.4rem);
        margin: 0;
    }
    .story-date {
        margin: 1rem 0 0;
        font-family: var(--font-gotu);
        font-size: 0.78rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--teal);
    }

    /* Book-like reading column: narrower measure, generous leading. */
    .reading {
        max-width: 40rem;
        margin-inline: auto;
        font-size: clamp(1.08rem, 1.5vw, 1.22rem);
        line-height: 1.9;
        color: var(--ink);
    }
    .reading :global(p) {
        margin: 0 0 1.55rem;
    }
    /* Script drop cap opens the story. */
    .reading :global(p:first-of-type::first-letter) {
        font-family: var(--font-charmonman);
        font-weight: 700;
        font-size: 3.6em;
        line-height: 0.72;
        float: left;
        margin: 0.06em 0.12em 0 0;
        color: var(--teal);
    }
    .reading :global(em) {
        color: var(--ink-soft);
    }
    /* `---` scene breaks become a calm centered ornament with breathing room. */
    .reading :global(hr) {
        border: 0;
        height: auto;
        margin: 2.75rem 0;
        text-align: center;
        overflow: visible;
    }
    .reading :global(hr::before) {
        content: "• • •";
        color: var(--gold);
        font-size: 0.9rem;
        letter-spacing: 0.5em;
    }
    /* The closing line of each story is the author's signature. */
    .reading :global(p:last-of-type) {
        margin-top: 2.75rem;
        font-family: var(--font-charmonman);
        font-weight: 700;
        font-size: clamp(1.5rem, 3vw, 2rem);
        line-height: 1.3;
        color: var(--teal);
        text-align: right;
    }
    /* Keep the signature clean — no drop cap if it were ever the first line. */
    .reading :global(p:last-of-type::first-letter) {
        font-size: inherit;
        float: none;
        margin: 0;
        color: inherit;
        font-family: inherit;
    }
</style>
