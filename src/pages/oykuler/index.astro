---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StoryCard from "../../components/StoryCard.astro";

const stories = (await getCollection("stories")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout
    title="Öyküler | Yeşil Mavi Hayat"
    description="Meltem Soğuk Stropoli’nin kaleminden kısa öyküler; Yeşil Mavi Hayat’ın satır aralarından hikâyeler."
>
    <main>
        <section class="pagehero">
            <div class="wrap">
                <header class="page-head">
                    <p class="kicker kicker--center reveal">Öykülerim</p>
                    <h1 class="display page-head__title reveal">Öyküler</h1>
                    <p class="page-head__intro reveal">
                        Yeşil Mavi Hayat’ın satır aralarından; Meltem Soğuk
                        Stropoli’nin kaleminden kısa öyküler.
                    </p>
                </header>
            </div>
        </section>

        <section class="section paper">
            <div class="wrap">
                <div class="story-grid">
                    {stories.map((story) => <StoryCard story={story} />)}
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .story-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.75rem;
    }
    @media (max-width: 640px) {
        .story-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
