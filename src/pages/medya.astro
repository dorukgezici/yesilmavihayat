---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import Layout from "../layouts/Layout.astro";

const articles = (await getCollection("news")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout
    title="Medya | Yeşil Mavi Hayat"
    description="Yeşil Mavi Hayat ve Meltem Soğuk Stropoli basında: ulusal gazeteler, dergiler, radyo ve televizyon programlarındaki haberler ve röportajlar."
>
    <main>
        <section class="pagehero">
            <div class="wrap">
                <header class="page-head">
                    <p class="kicker kicker--center reveal">Medyada</p>
                    <h1 class="display page-head__title reveal">
                        Basında Yeşil Mavi Hayat
                    </h1>
                    <p class="page-head__intro reveal">
                        Ulusal gazeteler, dergiler, radyo ve televizyon
                        programları Yeşil Mavi Hayat’ı ve Meltem Soğuk
                        Stropoli’yi konuk etti. {articles.length} haber ve röportaj
                        bir arada.
                    </p>
                </header>
            </div>
        </section>

        <section class="section paper">
            <div class="wrap">
                <div class="art-grid">
                    {
                        articles.map((article) => (
                            <ArticleCard article={article} />
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .art-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }
    @media (max-width: 640px) {
        .art-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
