---
type Link = { href: string; text: string };

const links: Link[] = [
    { href: "/yorumlar", text: "Sizden Gelenler" },
    { href: "/okuma-listesi", text: "Okuma Listesi" },
    { href: "/oykuler", text: "Öykülerim" },
    { href: "/medya", text: "Medya" },
];
const buyHref = "https://destekdukkan.com/magaza/urun/yesil-mavi-hayat";
---

<header class="site-head">
    <div class="site-head__inner">
        <a href="/" class="brand">
            <span class="brand__name">Yeşil Mavi Hayat</span>
            <span class="brand__author">Meltem Soğuk Stropoli</span>
        </a>

        <nav class="nav-desktop" aria-label="Ana menü">
            {
                links.map((link) => (
                    <a href={link.href} class="nav-link">
                        {link.text}
                    </a>
                ))
            }
            <a href={buyHref} target="_blank" rel="noopener" class="nav-buy">
                Satın Al
            </a>
        </nav>

        <details id="menu" class="nav-mobile">
            <summary class="nav-mobile__btn" aria-label="Menüyü aç veya kapat">
                <span class="nav-mobile__bars"><i></i><i></i><i></i></span>
            </summary>
            <div class="nav-mobile__sheet">
                {links.map((link) => <a href={link.href}>{link.text}</a>)}
                <a
                    href={buyHref}
                    target="_blank"
                    rel="noopener"
                    class="nav-buy nav-buy--block"
                >
                    Satın Al
                </a>
            </div>
        </details>
    </div>
</header>

<script>
    const menu = document.getElementById("menu");
    document.addEventListener("click", (event) => {
        if (menu && !menu.contains(event.target as Node))
            menu.removeAttribute("open");
    });
    document.addEventListener("astro:page-load", () =>
        menu?.removeAttribute("open"),
    );
</script>

<style>
    .site-head {
        position: relative;
        z-index: 40;
    }
    .site-head__inner {
        max-width: 80rem;
        margin-inline: auto;
        padding: 1.1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .brand {
        display: flex;
        flex-direction: column;
        line-height: 1;
        text-decoration: none;
    }
    .brand__name {
        font-family: var(--font-charmonman);
        font-weight: 700;
        font-size: clamp(1.4rem, 3vw, 1.9rem);
        color: var(--ink);
    }
    .brand__author {
        font-family: var(--font-gotu);
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--teal);
        margin-top: 0.35rem;
    }

    /* Desktop nav */
    .nav-desktop {
        display: flex;
        align-items: center;
        gap: 1.75rem;
    }
    .nav-link {
        font-family: var(--font-gotu);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        padding-bottom: 3px;
        background-image: linear-gradient(var(--teal), var(--teal));
        background-size: 0% 1.5px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        transition:
            background-size 0.3s cubic-bezier(0.22, 1, 0.36, 1),
            color 0.2s ease;
    }
    .nav-link:hover {
        color: var(--teal);
        background-size: 100% 1.5px;
    }
    .nav-buy {
        font-family: var(--font-gotu);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        background: var(--ink);
        color: var(--paper);
        padding: 0.6rem 1.05rem;
        border-radius: 999px;
        text-decoration: none;
        transition:
            transform 0.2s ease,
            background 0.2s ease;
    }
    .nav-buy:hover {
        background: #0c2a2f;
        transform: translateY(-1px);
    }

    /* Mobile nav */
    .nav-mobile {
        display: none;
        position: relative;
    }
    .nav-mobile__btn {
        list-style: none;
        cursor: pointer;
        padding: 0.5rem;
        display: inline-flex;
    }
    .nav-mobile__btn::-webkit-details-marker {
        display: none;
    }
    .nav-mobile__bars {
        display: grid;
        gap: 5px;
        width: 24px;
    }
    .nav-mobile__bars i {
        height: 2px;
        border-radius: 2px;
        background: var(--ink);
        transition:
            transform 0.25s ease,
            opacity 0.25s ease;
    }
    .nav-mobile[open] .nav-mobile__bars i:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .nav-mobile[open] .nav-mobile__bars i:nth-child(2) {
        opacity: 0;
    }
    .nav-mobile[open] .nav-mobile__bars i:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }
    .nav-mobile__sheet {
        position: absolute;
        right: 0;
        top: calc(100% + 0.6rem);
        min-width: 230px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 0.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        box-shadow: 0 22px 55px -24px rgba(16, 52, 58, 0.6);
        z-index: 50;
    }
    .nav-mobile__sheet a {
        font-family: var(--font-gotu);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        padding: 0.75rem 0.9rem;
        border-radius: 10px;
        transition: background 0.2s ease;
    }
    .nav-mobile__sheet a:hover {
        background: color-mix(in srgb, var(--ink) 6%, transparent);
    }
    /* Keep the buy pill's paper text — the generic sheet-link rule above
       would otherwise repaint it ink-on-ink (invisible). */
    .nav-mobile__sheet .nav-buy {
        color: var(--paper);
    }
    .nav-mobile__sheet .nav-buy:hover {
        background: #0c2a2f;
    }
    .nav-buy--block {
        justify-content: center;
        text-align: center;
        margin-top: 0.35rem;
    }

    @media (max-width: 860px) {
        .nav-desktop {
            display: none;
        }
        .nav-mobile {
            display: block;
        }
    }
</style>
